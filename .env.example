NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
CRM_PROVIDER=twenty
WORKFLOW_MAX_ATTEMPTS=3

# Optional shared secret expected from the website or Netlify webhook.
WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=
WEBHOOK_URL=
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=30
WORKSPACE_ALLOWED_ORIGIN=
WORKSPACE_API_SECRET=

# Supabase/Postgres operational persistence.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twenty CRM sync is intentionally disabled until credentials and field mapping are confirmed.
TWENTY_SYNC_ENABLED=false
QUICK_CAPTURE_SYNC_ENABLED=false
QUICK_CAPTURE_API_COMMIT_ENABLED=false
QUICK_CAPTURE_API_PREVIEW_ENABLED=true
QUICK_CAPTURE_MAX_RETRIES=3
QUICK_CAPTURE_RETRY_BASE_MS=1000
TWENTY_BASE_URL=https://api.twenty.com
TWENTY_API_BASE_URL=
TWENTY_API_KEY=
TWENTY_WORKSPACE_ID=

# Reserved for future personalization, enrichment, and agent workflows.
OPENAI_API_KEY=
OPENAI_MODEL=
