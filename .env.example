NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*
CRM_PROVIDER=twenty
WORKFLOW_MAX_ATTEMPTS=3

# Optional shared secret expected from the website or Netlify webhook.
WEBHOOK_SECRET=
WEBHOOK_SHARED_SECRET=
WEBHOOK_URL=
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=30
WORKSPACE_ALLOWED_ORIGIN=
WORKSPACE_API_SECRET=

# Supabase/Postgres operational persistence.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_VERIFICATION_ENABLED=false
SUPABASE_AUTH_REQUIRED_FOR_WORKSPACE_API=false

# Twenty CRM sync is intentionally disabled until credentials and field mapping are confirmed.
TWENTY_SYNC_ENABLED=false
QUICK_CAPTURE_SYNC_ENABLED=false
QUICK_CAPTURE_API_COMMIT_ENABLED=false
QUICK_CAPTURE_API_PREVIEW_ENABLED=true
QUICK_CAPTURE_MAX_RETRIES=3
QUICK_CAPTURE_RETRY_BASE_MS=1000
TWENTY_BASE_URL=https://api.twenty.com
TWENTY_API_BASE_URL=
TWENTY_API_KEY=
TWENTY_WORKSPACE_ID=
TWENTY_RELATIONSHIP_WRITES_ENABLED=false
TWENTY_PERSON_COMPANY_LINK_ENABLED=false
TWENTY_TASK_TARGET_LINK_ENABLED=false

# Legacy retrofit apply remains dry-run unless both LEGACY_RETROFIT_APPLY_ENABLED
# and LIVE_TEST are explicitly true. Owner recommendations are not applied.
LEGACY_RETROFIT_APPLY_ENABLED=false
LIVE_TEST=false
LEGACY_RETROFIT_ALL=false
LEGACY_RETROFIT_PAGE_SIZE=100
LEGACY_RETROFIT_MAX_PAGES=10
LEGACY_RETROFIT_PLAN_PATH=data/legacy-retrofit-plan.json
LEGACY_RETROFIT_BATCH_SIZE=5
LEGACY_RETROFIT_OFFSET=0
LEGACY_RETROFIT_INCLUDE_MANUAL_REVIEW=false
LEGACY_RETROFIT_FORCE_OVERWRITE=false

# Legacy owner cleanup is separate from outbound retrofit. It remains dry-run
# unless both LEGACY_OWNER_APPLY_ENABLED and LIVE_TEST are explicitly true.
LEGACY_OWNER_APPLY_ENABLED=false
LEGACY_OWNER_PLAN_PATH=data/legacy-owner-cleanup-plan.json
LEGACY_OWNER_BATCH_SIZE=5
LEGACY_OWNER_OFFSET=0
LEGACY_OWNER_FORCE_OVERWRITE=false

# Legacy task relationship retrofit is separate from People and owner cleanup.
# It remains dry-run unless both LEGACY_TASK_RETROFIT_APPLY_ENABLED and
# LIVE_TEST are explicitly true. Company taskTarget links are disabled by default.
LEGACY_TASK_RETROFIT_APPLY_ENABLED=false
LEGACY_TASK_RETROFIT_PLAN_PATH=data/legacy-task-retrofit-plan.json
LEGACY_TASK_RETROFIT_BATCH_SIZE=5
LEGACY_TASK_RETROFIT_OFFSET=0
LEGACY_TASK_LINK_COMPANY_ENABLED=false

# Missing next-task apply reads data/missing-next-task-plan.json and remains
# dry-run unless MISSING_NEXT_TASK_APPLY_ENABLED, LIVE_TEST, and an explicit
# MISSING_NEXT_TASK_BATCH_SIZE are set.
MISSING_NEXT_TASK_APPLY_ENABLED=false
MISSING_NEXT_TASK_PLAN_PATH=data/missing-next-task-plan.json
MISSING_NEXT_TASK_BATCH_SIZE=
MISSING_NEXT_TASK_OFFSET=0
MISSING_NEXT_TASK_INCLUDE_REVIEW=false
MISSING_NEXT_TASK_INCLUDE_TEST_RECORDS=false
MISSING_NEXT_TASK_FORCE=false
MISSING_NEXT_TASK_LINK_COMPANY=false
MISSING_NEXT_TASK_ALLOW_PAST_DUE=false

# Sent initial follow-up apply reads data/sent-initial-follow-up-plan.json and
# remains dry-run unless SENT_INITIAL_FOLLOW_UP_APPLY_ENABLED, LIVE_TEST, and an
# explicit SENT_INITIAL_FOLLOW_UP_BATCH_SIZE are set.
SENT_INITIAL_FOLLOW_UP_APPLY_ENABLED=false
SENT_INITIAL_FOLLOW_UP_PLAN_PATH=data/sent-initial-follow-up-plan.json
SENT_INITIAL_FOLLOW_UP_BATCH_SIZE=
SENT_INITIAL_FOLLOW_UP_OFFSET=0
SENT_INITIAL_FOLLOW_UP_UPDATE_PERSON_STAGE=false
SENT_INITIAL_FOLLOW_UP_LINK_COMPANY=false
SENT_INITIAL_FOLLOW_UP_INCLUDE_REVIEW=false
SENT_INITIAL_FOLLOW_UP_INCLUDE_TEST_RECORDS=false
SENT_INITIAL_FOLLOW_UP_FORCE=false
SENT_INITIAL_FOLLOW_UP_WRITE_DELAY_MS=1500
SENT_INITIAL_FOLLOW_UP_RETRY_AFTER_429=true
SENT_INITIAL_FOLLOW_UP_MAX_RETRY_ATTEMPTS=2
SENT_INITIAL_FOLLOW_UP_429_FALLBACK_DELAY_MS=60000
SENT_INITIAL_FOLLOW_UP_APPLY_OUTPUT_PATH=data/sent-initial-follow-up-apply-latest.json
SENT_INITIAL_FOLLOW_UP_RECOVERY_OUTPUT_PATH=data/sent-initial-follow-up-recovery-latest.json

# Manual lead normalization apply only updates missing outbound fields on People.
# It does not create Tasks, taskTargets, Companies, owner changes, or assessment
# field updates. Live writes require MANUAL_LEAD_NORMALIZATION_APPLY_ENABLED,
# LIVE_TEST, and MANUAL_LEAD_NORMALIZATION_BATCH_SIZE.
MANUAL_LEAD_NORMALIZATION_APPLY_ENABLED=false
MANUAL_LEAD_NORMALIZATION_PLAN_PATH=data/manual-lead-normalization-plan.json
MANUAL_LEAD_NORMALIZATION_BATCH_SIZE=
MANUAL_LEAD_NORMALIZATION_OFFSET=0
MANUAL_LEAD_NORMALIZATION_INCLUDE_REVIEW=false
MANUAL_LEAD_NORMALIZATION_INCLUDE_TEST_RECORDS=false
MANUAL_LEAD_NORMALIZATION_FORCE=false

# Workspace queue reads retry transient Twenty errors and can serve a short-lived
# stale cache when critical reads are rate-limited.
QUEUE_READ_RETRY_ENABLED=true
QUEUE_READ_RETRY_MAX_ATTEMPTS=2
QUEUE_READ_RETRY_BASE_MS=500
QUEUE_READ_CACHE_ENABLED=true
QUEUE_READ_CACHE_TTL_SECONDS=90

# Reserved for future personalization, enrichment, and agent workflows.
OPENAI_API_KEY=
OPENAI_MODEL=
